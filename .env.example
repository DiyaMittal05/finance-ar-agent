# Which LLM runs the agents: mock | anthropic | openai | gemini
LLM_PROVIDER=mock
# Optional model override (defaults per provider live in app/llm/registry.py)
LLM_MODEL=
PROMPT_VERSION=v3

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Judge model for evals (ideally a different provider than the system under test)
JUDGE_PROVIDER=mock
JUDGE_MODEL=

# Fixed "today" so aging and eval gold answers are reproducible
AS_OF_DATE=2026-09-30
